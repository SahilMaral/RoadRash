<script>
// roadrash.fun is home. The older addresses forward here, keeping the query string (invite links still work) and this
// browser's saved game and analytics id in the fragment: browsers keep those per site, so they'd otherwise be lost.
(function () {
  var HOME = "roadrash.fun", OLD = ["roadrash.kayode.me", "roadrash.pages.dev", "www.roadrash.fun"], KEYS = ["rr-save", "rr-id", "rr-tilt-sensitivity", "rr-install-dismissed", "rr-muted"];
  var PH = "ph_phc_ubS9W5oMHEYPKRKrWJb8f6MoTzrFQZKwEPb4YbXHvAGa_posthog";
  try {
    if (OLD.indexOf(location.hostname) >= 0) {
      var carry = {};
      KEYS.forEach(function (k) { var v = localStorage.getItem(k); if (v != null) carry[k] = v; });
      var ph = JSON.parse(localStorage.getItem(PH) || "null"); if (ph && ph.distinct_id) carry.ph = ph.distinct_id;
      var hash = Object.keys(carry).length ? "#carry=" + encodeURIComponent(btoa(unescape(encodeURIComponent(JSON.stringify(carry))))) : "";
      location.replace("https://" + HOME + location.pathname + location.search + hash);
    } else if (location.hash.indexOf("#carry=") === 0) {
      var got = JSON.parse(decodeURIComponent(escape(atob(decodeURIComponent(location.hash.slice(7))))));
      KEYS.forEach(function (k) { if (got[k] != null && localStorage.getItem(k) == null) localStorage.setItem(k, got[k]); });
      if (got.ph && !localStorage.getItem(PH)) sessionStorage.setItem("rr-carried-ph", got.ph);
      history.replaceState(null, "", location.pathname + location.search);
    }
  } catch (e) {}
})();
</script>
